# Required in production / Vercel (32+ characters). Without it, every deploy logs everyone out.
SESSION_SECRET=change-this-to-a-long-random-string
APP_URL=http://localhost:3000

# Vercel Blob — student planners persist in the cloud, not on a laptop.
BLOB_READ_WRITE_TOKEN=

# Daily mail job on Vercel. Set the same value in Vercel Cron Authorization.
CRON_SECRET=

# Optional public tour video (YouTube or Vimeo URL).
NEXT_PUBLIC_TOUR_VIDEO_URL=

# Optional extra admin besides buddy.askuala@gmail.com
ADMIN_EMAIL=

# Google OAuth Web client (or save it at /setup as admin). Redirect: {APP_URL}/api/google/callback
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# SMTP — required for sign-in notes and digests. Sender should be buddy.askuala@gmail.com.
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=buddy.askuala@gmail.com
SMTP_PASS=
