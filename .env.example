# Required in production / Vercel (32+ characters). Without it, every deploy logs everyone out.
SESSION_SECRET=change-this-to-a-long-random-string
APP_URL=http://localhost:3000

# Cloudflare R2 (preferred on Vercel). Free tier: 10 GB + 1M writes/lists + 10M reads / month.
# Create a bucket + API token at dash.cloudflare.com → R2. Local still uses data/ unless ASKUALA_USE_R2=1.
R2_ACCOUNT_ID=
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=
R2_BUCKET=
# R2_ENDPOINT=https://<ACCOUNT_ID>.r2.cloudflarestorage.com
# ASKUALA_USE_R2=1

# Vercel Blob — only if R2 is not set. Local ignores this unless ASKUALA_USE_BLOB=1.
BLOB_READ_WRITE_TOKEN=
# ASKUALA_USE_BLOB=1

# Daily mail job on Vercel. Set the same value in Vercel Cron Authorization.
CRON_SECRET=

# Optional public tour video (YouTube or Vimeo URL).
NEXT_PUBLIC_TOUR_VIDEO_URL=

# Optional extra admin besides buddy.askuala@gmail.com
ADMIN_EMAIL=

# Google OAuth Web client (or save it at /setup as admin). Redirect: {APP_URL}/api/google/callback
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# SMTP — required for sign-in notes and digests. Sender should be buddy.askuala@gmail.com.
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=buddy.askuala@gmail.com
SMTP_PASS=
